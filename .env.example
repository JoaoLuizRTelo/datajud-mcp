# --- DataJud (CNJ) ---------------------------------------------------------
# Public API key published by CNJ. It is NOT a secret, but CNJ may rotate it at any time.
# Always copy the current value from https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Optional tuning (defaults shown). DataJud queries routinely take 20-60 s.
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# DATAJUD_TIMEOUT_MS=90000
# DATAJUD_MAX_ATTEMPTS=4
# DATAJUD_REQUESTS_PER_MINUTE=120

# --- Example agent (examples/agent) ----------------------------------------
# Only needed for `npm run agent` and `npm run evals`. Never commit a real key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# AGENT_MAX_ITERATIONS=6
