{
  "name": "datajud-mcp",
  "version": "0.1.0",
  "description": "MCP server for Brazil's official court data API (CNJ DataJud), plus an example Claude agent that summarizes cases.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "datajud-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "agent": "tsx examples/agent/cli.ts",
    "evals": "tsx evals/run-evals.ts",
    "record-fixture": "tsx scripts/record-fixture.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "fix": "eslint . --fix && prettier --write ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "datajud",
    "cnj",
    "claude",
    "agent",
    "brazil",
    "courts"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
